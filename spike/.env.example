# 이 파일을 .env 로 복사해서 쓴다. .env 는 git에 올라가지 않는다.

# 생성된 Playwright 테스트가 접속할 대상 주소 (CI에서도 같은 이름의 환경변수를 쓴다)
KOALA_BASE_URL=http://localhost:3000

# 기본 테스트 계정 (선택)
# 사이드패널 프로필에 계정을 입력하면 그 값이 우선한다. 생성된 테스트 코드는 이 값을 읽는다.
KOALA_USER=
KOALA_PASS=

# 경로 그래프 DB (선택). npm run graph:up 으로 켠 컨테이너의 기본 주소
# KOALA_PG=postgres://koala:koala@127.0.0.1:5532/koala

# Claude Code 실행 파일 위치. 자동으로 못 찾을 때만 지정한다
# CLAUDE_BIN=/Users/me/.local/bin/claude
# CLAUDE_BIN=C:\Users\me\AppData\Roaming\npm\claude.cmd
