{
  "manifest_version": 3,
  "name": "koala",
  "version": "0.3.1",
  "description": "사이드패널에서 지시하면 로컬 Claude Code가 현재 탭을 조작하고 Playwright 코드로 기록한다",
  "key": "",
  "permissions": [
    "sidePanel",
    "scripting",
    "tabs",
    "debugger",
    "storage",
    "nativeMessaging"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "koala",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
